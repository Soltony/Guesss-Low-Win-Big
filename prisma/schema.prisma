// GuessLow — Lowest Unique Bid Auction platform
// Prisma schema. SQL Server does not support Prisma enums, so status-like
// columns are Strings; the allowed values live in `src/lib/types.ts` as unions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// AUTH & ADMIN USERS
// --------------------------------------

model User {
  id                     String   @id @default(cuid())
  fullName               String
  email                  String   @unique
  phoneNumber            String   @unique
  password               String
  passwordChangeRequired Boolean  @default(true)
  status                 String   @default("ACTIVE") // ACTIVE | SUSPENDED | DISABLED
  roleId                 String
  role                   Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lastLoginAt            DateTime?
  failedLoginCount       Int      @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  sessions           Session[]
  createdChanges     PendingChange[]      @relation("ChangeCreatedBy")
  approvedChanges    PendingChange[]      @relation("ChangeApprovedBy")
  createdItems       Item[]               @relation("ItemCreatedBy")
  createdAuctions    Auction[]            @relation("AuctionCreatedBy")
  settledAuctions    Auction[]            @relation("AuctionSettledBy")
  verifiedWinners    Winner[]             @relation("WinnerVerifiedBy")
  fulfilledWinners   Winner[]             @relation("WinnerFulfilledBy")
  resolvedPayments   PaymentTransaction[] @relation("PaymentResolvedBy")
  updatedSettings    SystemSetting[]      @relation("SettingUpdatedBy")
  moderatedBidders   Bidder[]             @relation("BidderModeratedBy")
  addedParticipants  AuctionParticipant[] @relation("ParticipantAddedBy")
  createdLists       ParticipantList[]    @relation("ListCreatedBy")

  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   @db.NVarChar(Max) // JSON: { "<module>": { read, create, update, delete, approve } }
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

// Refresh-token storage so sessions can be revoked server-side.
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  jti          String? // JTI of the access token currently bound to this session
  revoked      Boolean  @default(false)
  expiresAt    DateTime
  lastActivity DateTime @default(now())
  ipAddress    String?
  userAgent    String?  @db.NVarChar(1000)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([jti])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String // admin user id, bidder phone, or "SYSTEM"
  actorName     String?
  actorType     String   @default("ADMIN") // ADMIN | BIDDER | SYSTEM | EXTERNAL
  action        String
  entity        String?
  entityId      String?
  details       String?  @db.NVarChar(Max) // JSON
  ipAddress     String?
  userAgent     String?  @db.NVarChar(1000)
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([correlationId])
}

// --------------------------------------
// CUSTOMERS (mini-app bidders)
// --------------------------------------

model Bidder {
  id           String   @id @default(cuid())
  phoneNumber  String   @unique // resolved from the super-app token
  fullName     String?
  email        String?
  language     String   @default("en") // en | am
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED | BLOCKED
  statusReason String?
  moderatedById String?
  moderatedBy  User?    @relation("BidderModeratedBy", fields: [moderatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  totalBids    Int      @default(0)
  totalSpent   Decimal  @default(0) @db.Decimal(18, 2)
  winsCount    Int      @default(0)

  // Sign-in the ad popup was last served to, so one login gets one batch no
  // matter how many pages the bidder opens. See src/lib/ads.ts.
  lastAdSessionId String?

  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bids      Bid[]
  payments  PaymentTransaction[]
  wins      Winner[]
  favorites BidderFavorite[]
  results   AuctionResult[]
  credits   BidCredit[]
  adViews   AdImpression[]

  @@index([status])
  @@index([moderatedById])
}

model BidderFavorite {
  id        String   @id @default(cuid())
  bidderId  String
  bidder    Bidder   @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  @@unique([bidderId, auctionId])
  @@index([auctionId])
}

// --------------------------------------
// CATALOG
// --------------------------------------

model Category {
  id           String    @id @default(cuid())
  name         String
  nameAm       String?
  slug         String    @unique
  imageUrl     String?   @db.NVarChar(Max)
  icon         String? // lucide icon name
  displayOrder Int       @default(0)
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items    Item[]
  auctions Auction[]
}

model Item {
  id            String   @id @default(cuid())
  name          String
  nameAm        String?
  description   String   @db.NVarChar(Max)
  descriptionAm String?  @db.NVarChar(Max)
  brand         String?
  model         String?
  sku           String?
  retailPrice   Decimal  @db.Decimal(18, 2) // "actual price" shown as the value of the prize
  images        String   @default("[]") @db.NVarChar(Max) // JSON array of URLs
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stockQty      Int      @default(1)
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdById   String?
  createdBy     User?    @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auctions Auction[]

  @@index([categoryId])
  @@index([status])
  @@index([createdById])
}

// --------------------------------------
// AUCTIONS
// --------------------------------------

model Auction {
  id       String @id @default(cuid())
  code     String @unique // short public code shown in the app, e.g. "195"
  title    String
  titleAm  String?
  subtitle String?

  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Economics — every one of these is configurable per auction from the admin.
  bidFee         Decimal @db.Decimal(18, 2) // service fee charged per bid
  minBidAmount   Decimal @db.Decimal(18, 2)
  maxBidAmount   Decimal @db.Decimal(18, 2)
  bidStep        Decimal @default(0.01) @db.Decimal(18, 2)
  maxBidsPerUser Int     @default(100) // cap per bidder
  maxTotalBids   Int     @default(0) // cap across the whole auction; 0 = unlimited
  currency       String  @default("ETB")

  startAt           DateTime
  endAt             DateTime
  autoExtendMinutes Int      @default(0) // extend end time if a bid lands in the last N minutes
  extendedCount     Int      @default(0)

  status String @default("DRAFT") // DRAFT | PENDING_APPROVAL | SCHEDULED | LIVE | ENDED | SETTLED | CANCELLED

  // Who may take part at all. OPEN admits any bidder; RESTRICTED admits only
  // the phone numbers on this auction's participant list, whoever else finds
  // the page. See src/lib/eligibility.ts.
  eligibilityMode String @default("OPEN") // OPEN | RESTRICTED

  featured     Boolean @default(false)
  displayOrder Int     @default(0)
  viewCount    Int     @default(0)
  bidCount     Int     @default(0) // ACTIVE bids only
  bidderCount  Int     @default(0)

  termsId String?
  terms   TermsAndConditions? @relation(fields: [termsId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Which saved roster this auction's participant list was copied from, if any.
  // Provenance only: the rows in `participants` are a snapshot taken at attach
  // time, so editing the saved list never changes who may bid on an auction
  // that is already running. `participantsSyncedAt` records when that snapshot
  // was taken, which is what "the list has changed since" is measured against.
  sourceListId         String?
  sourceList           ParticipantList? @relation(fields: [sourceListId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  participantsSyncedAt DateTime?

  winnerBidId     String?
  settledAt       DateTime?
  settledById     String?
  settledBy       User?     @relation("AuctionSettledBy", fields: [settledById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cancelledReason String?

  // ---- Re-auction rules ----
  // An auction that ends without a valid winner can be re-run automatically.
  // Every round inherits this block, so the rules stay fixed for the whole chain.
  reauctionEnabled              Boolean @default(false)
  maxReauctionRounds            Int     @default(1) // how many re-runs the original may spawn
  reauctionDurationHours        Int     @default(24)
  reauctionStartDelayMinutes    Int     @default(0)
  reauctionAllowNewBidders      Boolean @default(true)
  reauctionAllowPreviousBidders Boolean @default(true)
  // Below this many confirmed bids the round is not viable and is re-auctioned
  // even if one amount happened to be unique. 0 disables the floor.
  reauctionMinBids              Int     @default(0)

  // ---- Re-auction lineage ----
  // `originalAuctionId` points at the root of the chain on every re-run, so the
  // whole lineage is one indexed query; the root itself leaves it null.
  reauctionRound    Int       @default(0) // 0 = original auction
  parentAuctionId   String?
  parentAuction     Auction?  @relation("AuctionReauction", fields: [parentAuctionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reauctions        Auction[] @relation("AuctionReauction")
  originalAuctionId String?
  reauctionState    String    @default("NONE") // NONE | NOT_NEEDED | PENDING | CREATED | EXHAUSTED | DISABLED | BLOCKED
  reauctionReason   String?
  reauctionedAt     DateTime?

  createdById String?
  createdBy   User?     @relation("AuctionCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bids         Bid[]
  results      AuctionResult[]
  ledger       AuctionLedgerEntry[]
  winner       Winner?
  payments     PaymentTransaction[]
  favorites    BidderFavorite[]
  credits      BidCredit[]
  participants AuctionParticipant[]

  @@index([status, endAt])
  @@index([categoryId])
  @@index([itemId])
  @@index([featured])
  @@index([winnerBidId])
  @@index([createdById])
  @@index([settledById])
  @@index([termsId])
  @@index([sourceListId])
  @@index([parentAuctionId])
  @@index([originalAuctionId])
}

// A reusable roster of phone numbers — staff, a loyalty tier, one branch's
// customers — uploaded once under Content and attached to any number of
// auctions, exactly as a terms version is.
//
// Attaching copies the entries into `AuctionParticipant` rather than leaving
// the auction pointing here, because the two have different lifetimes: a saved
// list is edited whenever staff join or leave, while a running auction's roster
// must not change under the people bidding in it. See `applyListToAuction` in
// src/lib/participant-lists.ts.
model ParticipantList {
  id          String  @id @default(cuid())
  name        String
  description String?
  // An archived list stays attached to the auctions that already used it, but
  // is no longer offered when setting up a new one.
  active      Boolean @default(true)

  createdById String?
  createdBy   User?    @relation("ListCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries  ParticipantListEntry[]
  auctions Auction[]

  @@index([active])
  @@index([createdById])
}

// One phone number on a saved list. Mirrors AuctionParticipant's shape so a
// copy in either direction is a straight field-for-field map.
model ParticipantListEntry {
  id          String          @id @default(cuid())
  listId      String
  list        ParticipantList @relation(fields: [listId], references: [id], onDelete: Cascade)
  phoneNumber String
  fullName    String?
  note        String?
  createdAt   DateTime        @default(now())

  @@unique([listId, phoneNumber])
  @@index([listId])
  @@index([phoneNumber])
}

// One approved participant on a RESTRICTED auction.
//
// Keyed by phone number rather than by bidder, so an operator can upload the
// list before the people on it have ever opened the mini-app — a Bidder row
// only exists once someone connects. `phoneNumber` is stored in the same
// normalised form as `Bidder.phoneNumber`, which is what makes the two compare
// equal however the number was typed into the spreadsheet.
model AuctionParticipant {
  id          String  @id @default(cuid())
  auctionId   String
  auction     Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  phoneNumber String
  fullName    String?
  note        String?
  source      String  @default("UPLOAD") // UPLOAD | MANUAL | INHERITED | LIST

  addedById String?
  addedBy   User?    @relation("ParticipantAddedBy", fields: [addedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  @@unique([auctionId, phoneNumber])
  @@index([auctionId])
  @@index([phoneNumber])
  @@index([addedById])
}

model Bid {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    Bidder  @relation(fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // The bid amount, sealed with AES-256-GCM under a key that lives in the
  // environment rather than the database — the amounts are the whole secret of
  // a lowest-unique-bid auction, so a database read must not yield them. The
  // envelope is bound to this row's auction and bidder, so a ciphertext cannot
  // be moved between bids. Encoded as the fixed 2-decimal string, which keeps
  // uniqueness grouping exact where a float would merge or split amounts and
  // corrupt the winner calculation. Only src/lib/bid-crypto.ts opens it, and
  // only src/lib/bid-visibility.ts decides who may see the result.
  //
  // There is deliberately no index on this column: a ciphertext is random, so
  // nothing can be grouped, ranked, or ranged over in SQL. Settlement loads one
  // auction's bids and ranks them in memory — see rankUniqueBids.
  amountCipher String @db.NVarChar(512)

  // The service fee, which is not secret: it is the same for every bid on an
  // auction, appears on the payment receipt, and is summed for revenue reports.
  feeAmount Decimal @db.Decimal(18, 2)

  status   String @default("PENDING_PAYMENT") // PENDING_PAYMENT | ACTIVE | FAILED | VOID | REFUNDED
  channel  String @default("MINIAPP") // MINIAPP | USSD | ADMIN
  sequence Int    @default(1) // nth bid by this bidder on this auction

  // Funded by a bid the bidder already paid for in an earlier round of this
  // auction's chain, so `feeAmount` is 0 and no new charge was raised.
  carriedOver Boolean @default(false)

  // Filled in at settlement; null while the auction is running so nothing
  // about uniqueness can leak to bidders mid-auction.
  isUnique         Boolean?
  rankAtSettlement Int?

  ipAddress   String?
  userAgent   String?   @db.NVarChar(1000)
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  voidedAt    DateTime?
  voidReason  String?

  payment PaymentTransaction? @relation("BidPayment")
  result  AuctionResult?
  winner  Winner?

  @@index([auctionId, status])
  @@index([bidderId, auctionId])
  @@index([createdAt])
}

// Bids a bidder already paid for in an earlier round, spendable on one
// re-auction. Granted when the re-auction is created and drawn down as the
// bidder places bids, which is what keeps anyone from paying twice for the
// same bid across a chain of re-auctions.
//
// `remaining` is decremented by a conditional UPDATE (`remaining > 0`) so two
// concurrent bids can never spend the same credit; `granted` stays untouched
// as the audit record of what was carried forward.
model BidCredit {
  id       String @id @default(cuid())
  bidderId String
  bidder   Bidder @relation(fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  auctionId String // the re-auction these prepaid bids may be spent on
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  sourceAuctionId String // round the credits were carried from
  rootAuctionId   String // original auction of the chain

  granted   Int
  consumed  Int     @default(0)
  remaining Int
  unitFee   Decimal @db.Decimal(18, 2) // fee value of one carried bid, for reporting

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bidderId, auctionId])
  @@index([auctionId])
  @@index([bidderId])
  @@index([rootAuctionId])
}

// Ranked snapshot of the unique bids, written once at settlement.
// Rank 1 is the winner; rank 2+ are the fallbacks if a winner forfeits.
model AuctionResult {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidId     String  @unique
  bid       Bid     @relation(fields: [bidId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bidderId  String
  bidder    Bidder  @relation(fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount    Decimal @db.Decimal(18, 2)
  rank      Int
  createdAt DateTime @default(now())

  @@unique([auctionId, rank])
  @@index([bidderId])
}


model AuctionLedgerEntry {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(18, 2)
  bidCount Int
  isUnique Boolean

  uniqueRank Int?
  
  bidderIds String @db.NVarChar(Max)

  createdAt DateTime @default(now())

  @@unique([auctionId, amount])
}

model Winner {
  id        String  @id @default(cuid())
  auctionId String  @unique
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidId     String  @unique
  bid       Bid     @relation(fields: [bidId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bidderId  String
  bidder    Bidder  @relation(fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount    Decimal @db.Decimal(18, 2) // the winning bid amount, i.e. what the item is paid for

  status        String    @default("PENDING_CLAIM") // PENDING_CLAIM | CLAIMED | VERIFIED | FULFILLED | FORFEITED | CANCELLED
  claimDeadline DateTime?
  claimedAt     DateTime?

  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("WinnerVerifiedBy", fields: [verifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  deliveryName    String?
  deliveryPhone   String?
  deliveryAddress String? @db.NVarChar(Max)
  deliveryNote    String? @db.NVarChar(Max)
  fulfillmentRef  String?

  fulfilledAt     DateTime?
  fulfilledById   String?
  fulfilledBy     User?     @relation("WinnerFulfilledBy", fields: [fulfilledById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forfeitedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bidderId])
  @@index([status])
  @@index([verifiedById])
  @@index([fulfilledById])
}

// --------------------------------------
// PAYMENTS (super-app payment gateway)
// --------------------------------------

model PaymentTransaction {
  id            String  @id @default(cuid())
  transactionId String  @unique // uuid we generate and sign
  txnRef        String? // reference returned by the gateway
  bidderId      String
  bidder        Bidder  @relation(fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auctionId     String?
  auction       Auction? @relation(fields: [auctionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bidId         String?  @unique
  bid           Bid?     @relation("BidPayment", fields: [bidId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  amount  Decimal @db.Decimal(18, 2)
  purpose String  @default("BID_FEE") // BID_FEE
  status  String  @default("PENDING") // PENDING | SUCCESS | FAILED | EXPIRED | REVERSED

  paidByNumber    String?
  accountNo       String?
  transactionTime String?
  gatewayStatus   String?
  failureReason   String? @db.NVarChar(Max)
  requestPayload  String? @db.NVarChar(Max)
  callbackPayload String? @db.NVarChar(Max)

  resolvedById   String?
  resolvedBy     User?     @relation("PaymentResolvedBy", fields: [resolvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedAt     DateTime?
  resolutionNote String?   @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([bidderId])
  @@index([auctionId])
  @@index([txnRef])
  @@index([createdAt])
  @@index([resolvedById])
}

// --------------------------------------
// MAKER–CHECKER
// --------------------------------------

model PendingChange {
  id            String  @id @default(cuid())
  entityType    String // Auction | Item | Category | SystemSetting | Banner | Role | ...
  entityId      String?
  action        String // CREATE | UPDATE | DELETE | PUBLISH | CANCEL | SETTLE
  payload       String  @db.NVarChar(Max) // JSON of the requested state
  previousData  String? @db.NVarChar(Max) // JSON of the state before the change
  changedFields String? @db.NVarChar(Max) // JSON array of field names that actually changed
  summary       String?

  status  String  @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  comment String? @db.NVarChar(Max)

  createdById String
  createdBy   User      @relation("ChangeCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById String?
  approvedBy   User?    @relation("ChangeApprovedBy", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([status])
  @@index([entityType, entityId])
  @@index([createdById])
  @@index([approvedById])
}

// --------------------------------------
// CMS & NOTIFICATIONS
// --------------------------------------

model Banner {
  id           String    @id @default(cuid())
  title        String
  titleAm      String?
  subtitle     String?
  imageUrl     String    @db.NVarChar(Max)
  imageAlt     String?   @db.NVarChar(Max) // null/empty = decorative; set when the artwork carries wording the title does not
  linkUrl      String?
  displayOrder Int       @default(0)
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// Promotional popup shown over the mini-app. `POST_LOGIN` ads are served the
// first time the app is opened with a live bidder session; the frequency rule
// below is what keeps the same bidder from seeing one on every visit.
model Advertisement {
  id       String  @id @default(cuid())
  title    String
  titleAm  String?
  body     String? @db.NVarChar(Max)
  bodyAm   String? @db.NVarChar(Max)
  imageUrl String? @db.NVarChar(Max)
  imageAlt String? @db.NVarChar(Max) // null/empty = decorative; see Banner.imageAlt

  ctaLabel   String?
  ctaLabelAm String?
  linkUrl    String?

  placement String @default("POST_LOGIN") // POST_LOGIN
  frequency String @default("ONCE_PER_DAY") // EVERY_LOGIN | ONCE_PER_DAY | ONCE
  status    String @default("ACTIVE") // ACTIVE | INACTIVE

  displayOrder Int       @default(0)
  startAt      DateTime?
  endAt        DateTime?
  // Seconds before the popup dismisses itself; 0 waits for the bidder.
  autoCloseSeconds Int @default(0)
  // Seconds the ad must stay on screen before the close button unlocks.
  // 0 lets the bidder dismiss it straight away.
  minViewSeconds Int @default(0)

  // Denormalised totals so the admin list needs no aggregate per row.
  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views AdImpression[]

  @@index([status, placement])
}

// One row per (ad, bidder) — the record the frequency cap is enforced against.
model AdImpression {
  id       String        @id @default(cuid())
  adId     String
  ad       Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)
  bidderId String
  bidder   Bidder        @relation(fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  seenCount   Int       @default(0)
  clickCount  Int       @default(0)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  lastClickAt DateTime?

  @@unique([adId, bidderId])
  @@index([bidderId])
}

model TermsAndConditions {
  id        String   @id @default(cuid())
  version   String
  title     String
  contentEn String   @db.NVarChar(Max)
  contentAm String?  @db.NVarChar(Max)
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auctions Auction[]
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  code      String   @unique // BID_CONFIRMED | AUCTION_ENDING | WINNER_ANNOUNCED | ...
  name      String
  channel   String   @default("SMS") // SMS | PUSH | INAPP
  subject   String?
  bodyEn    String   @db.NVarChar(Max)
  bodyAm    String?  @db.NVarChar(Max)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationLog {
  id           String    @id @default(cuid())
  templateCode String?
  channel      String    @default("SMS")
  recipient    String
  body         String    @db.NVarChar(Max)
  status       String    @default("QUEUED") // QUEUED | SENT | FAILED
  error        String?   @db.NVarChar(Max)
  bidderId     String?
  auctionId    String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([recipient])
  @@index([createdAt])
}

// --------------------------------------
// SETTINGS
// --------------------------------------

// Key/value global configuration. Everything the business may want to tune
// without a redeploy lives here — see src/lib/settings.ts for the defaults.
model SystemSetting {
  key         String   @id
  value       String   @db.NVarChar(Max) // JSON-encoded
  description String?
  category    String   @default("general")
  updatedById String?
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([updatedById])
}
