// GuessLow — Lowest Unique Bid Auction platform
// Prisma schema. SQL Server does not support Prisma enums, so status-like
// columns are Strings; the allowed values live in `src/lib/types.ts` as unions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// AUTH & ADMIN USERS
// --------------------------------------

model User {
  id                     String   @id @default(cuid())
  fullName               String
  email                  String   @unique
  phoneNumber            String   @unique
  password               String
  passwordChangeRequired Boolean  @default(true)
  status                 String   @default("ACTIVE") // ACTIVE | SUSPENDED | DISABLED
  roleId                 String
  role                   Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lastLoginAt            DateTime?
  failedLoginCount       Int      @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  sessions           Session[]
  createdChanges     PendingChange[]      @relation("ChangeCreatedBy")
  approvedChanges    PendingChange[]      @relation("ChangeApprovedBy")
  createdItems       Item[]               @relation("ItemCreatedBy")
  createdAuctions    Auction[]            @relation("AuctionCreatedBy")
  settledAuctions    Auction[]            @relation("AuctionSettledBy")
  verifiedWinners    Winner[]             @relation("WinnerVerifiedBy")
  fulfilledWinners   Winner[]             @relation("WinnerFulfilledBy")
  resolvedPayments   PaymentTransaction[] @relation("PaymentResolvedBy")
  updatedSettings    SystemSetting[]      @relation("SettingUpdatedBy")
  moderatedBidders   Bidder[]             @relation("BidderModeratedBy")

  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   @db.NVarChar(Max) // JSON: { "<module>": { read, create, update, delete, approve } }
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

// Refresh-token storage so sessions can be revoked server-side.
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  jti          String? // JTI of the access token currently bound to this session
  revoked      Boolean  @default(false)
  expiresAt    DateTime
  lastActivity DateTime @default(now())
  ipAddress    String?
  userAgent    String?  @db.NVarChar(1000)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([jti])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String // admin user id, bidder phone, or "SYSTEM"
  actorName     String?
  actorType     String   @default("ADMIN") // ADMIN | BIDDER | SYSTEM | EXTERNAL
  action        String
  entity        String?
  entityId      String?
  details       String?  @db.NVarChar(Max) // JSON
  ipAddress     String?
  userAgent     String?  @db.NVarChar(1000)
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([correlationId])
}

// --------------------------------------
// CUSTOMERS (mini-app bidders)
// --------------------------------------

model Bidder {
  id           String   @id @default(cuid())
  phoneNumber  String   @unique // resolved from the super-app token
  fullName     String?
  email        String?
  language     String   @default("en") // en | am
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED | BLOCKED
  statusReason String?
  moderatedById String?
  moderatedBy  User?    @relation("BidderModeratedBy", fields: [moderatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  totalBids    Int      @default(0)
  totalSpent   Decimal  @default(0) @db.Decimal(18, 2)
  winsCount    Int      @default(0)

  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bids      Bid[]
  payments  PaymentTransaction[]
  wins      Winner[]
  favorites BidderFavorite[]
  results   AuctionResult[]

  @@index([status])
  @@index([moderatedById])
}

model BidderFavorite {
  id        String   @id @default(cuid())
  bidderId  String
  bidder    Bidder   @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  @@unique([bidderId, auctionId])
  @@index([auctionId])
}

// --------------------------------------
// CATALOG
// --------------------------------------

model Category {
  id           String    @id @default(cuid())
  name         String
  nameAm       String?
  slug         String    @unique
  imageUrl     String?   @db.NVarChar(Max)
  icon         String? // lucide icon name
  displayOrder Int       @default(0)
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items    Item[]
  auctions Auction[]
}

model Item {
  id            String   @id @default(cuid())
  name          String
  nameAm        String?
  description   String   @db.NVarChar(Max)
  descriptionAm String?  @db.NVarChar(Max)
  brand         String?
  model         String?
  sku           String?
  retailPrice   Decimal  @db.Decimal(18, 2) // "actual price" shown as the value of the prize
  images        String   @default("[]") @db.NVarChar(Max) // JSON array of URLs
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stockQty      Int      @default(1)
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdById   String?
  createdBy     User?    @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auctions Auction[]

  @@index([categoryId])
  @@index([status])
  @@index([createdById])
}

// --------------------------------------
// AUCTIONS
// --------------------------------------

model Auction {
  id       String @id @default(cuid())
  code     String @unique // short public code shown in the app, e.g. "195"
  title    String
  titleAm  String?
  subtitle String?

  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Economics — every one of these is configurable per auction from the admin.
  bidFee         Decimal @db.Decimal(18, 2) // service fee charged per bid
  minBidAmount   Decimal @db.Decimal(18, 2)
  maxBidAmount   Decimal @db.Decimal(18, 2)
  bidStep        Decimal @default(0.01) @db.Decimal(18, 2)
  maxBidsPerUser Int     @default(100)
  currency       String  @default("ETB")

  startAt           DateTime
  endAt             DateTime
  autoExtendMinutes Int      @default(0) // extend end time if a bid lands in the last N minutes
  extendedCount     Int      @default(0)

  status String @default("DRAFT") // DRAFT | PENDING_APPROVAL | SCHEDULED | LIVE | ENDED | SETTLED | CANCELLED

  featured     Boolean @default(false)
  displayOrder Int     @default(0)
  viewCount    Int     @default(0)
  bidCount     Int     @default(0) // ACTIVE bids only
  bidderCount  Int     @default(0)

  termsId String?
  terms   TermsAndConditions? @relation(fields: [termsId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  winnerBidId     String?
  settledAt       DateTime?
  settledById     String?
  settledBy       User?     @relation("AuctionSettledBy", fields: [settledById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cancelledReason String?

  createdById String?
  createdBy   User?     @relation("AuctionCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bids      Bid[]
  results   AuctionResult[]
  winner    Winner?
  payments  PaymentTransaction[]
  favorites BidderFavorite[]

  @@index([status, endAt])
  @@index([categoryId])
  @@index([itemId])
  @@index([featured])
  @@index([winnerBidId])
  @@index([createdById])
  @@index([settledById])
  @@index([termsId])
}

model Bid {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    Bidder  @relation(fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Decimal(18,2) keeps uniqueness grouping exact — float rounding would
  // silently merge or split bid amounts and corrupt the winner calculation.
  amount    Decimal @db.Decimal(18, 2)
  feeAmount Decimal @db.Decimal(18, 2)

  status   String @default("PENDING_PAYMENT") // PENDING_PAYMENT | ACTIVE | FAILED | VOID | REFUNDED
  channel  String @default("MINIAPP") // MINIAPP | USSD | ADMIN
  sequence Int    @default(1) // nth bid by this bidder on this auction

  // Filled in at settlement; null while the auction is running so nothing
  // about uniqueness can leak to bidders mid-auction.
  isUnique         Boolean?
  rankAtSettlement Int?

  ipAddress   String?
  userAgent   String?   @db.NVarChar(1000)
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  voidedAt    DateTime?
  voidReason  String?

  payment PaymentTransaction? @relation("BidPayment")
  result  AuctionResult?
  winner  Winner?

  @@index([auctionId, amount])
  @@index([auctionId, status])
  @@index([bidderId, auctionId])
  @@index([createdAt])
}

// Ranked snapshot of the unique bids, written once at settlement.
// Rank 1 is the winner; rank 2+ are the fallbacks if a winner forfeits.
model AuctionResult {
  id        String  @id @default(cuid())
  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidId     String  @unique
  bid       Bid     @relation(fields: [bidId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bidderId  String
  bidder    Bidder  @relation(fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount    Decimal @db.Decimal(18, 2)
  rank      Int
  createdAt DateTime @default(now())

  @@unique([auctionId, rank])
  @@index([bidderId])
}

model Winner {
  id        String  @id @default(cuid())
  auctionId String  @unique
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidId     String  @unique
  bid       Bid     @relation(fields: [bidId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bidderId  String
  bidder    Bidder  @relation(fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount    Decimal @db.Decimal(18, 2) // the winning bid amount, i.e. what the item is paid for

  status        String    @default("PENDING_CLAIM") // PENDING_CLAIM | CLAIMED | VERIFIED | FULFILLED | FORFEITED | CANCELLED
  claimDeadline DateTime?
  claimedAt     DateTime?

  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("WinnerVerifiedBy", fields: [verifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  deliveryName    String?
  deliveryPhone   String?
  deliveryAddress String? @db.NVarChar(Max)
  deliveryNote    String? @db.NVarChar(Max)
  fulfillmentRef  String?

  fulfilledAt     DateTime?
  fulfilledById   String?
  fulfilledBy     User?     @relation("WinnerFulfilledBy", fields: [fulfilledById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forfeitedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bidderId])
  @@index([status])
  @@index([verifiedById])
  @@index([fulfilledById])
}

// --------------------------------------
// PAYMENTS (super-app payment gateway)
// --------------------------------------

model PaymentTransaction {
  id            String  @id @default(cuid())
  transactionId String  @unique // uuid we generate and sign
  txnRef        String? // reference returned by the gateway
  bidderId      String
  bidder        Bidder  @relation(fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auctionId     String?
  auction       Auction? @relation(fields: [auctionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bidId         String?  @unique
  bid           Bid?     @relation("BidPayment", fields: [bidId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  amount  Decimal @db.Decimal(18, 2)
  purpose String  @default("BID_FEE") // BID_FEE
  status  String  @default("PENDING") // PENDING | SUCCESS | FAILED | EXPIRED | REVERSED

  paidByNumber    String?
  accountNo       String?
  transactionTime String?
  gatewayStatus   String?
  failureReason   String? @db.NVarChar(Max)
  requestPayload  String? @db.NVarChar(Max)
  callbackPayload String? @db.NVarChar(Max)

  resolvedById   String?
  resolvedBy     User?     @relation("PaymentResolvedBy", fields: [resolvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedAt     DateTime?
  resolutionNote String?   @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([bidderId])
  @@index([auctionId])
  @@index([txnRef])
  @@index([createdAt])
  @@index([resolvedById])
}

// --------------------------------------
// MAKER–CHECKER
// --------------------------------------

model PendingChange {
  id            String  @id @default(cuid())
  entityType    String // Auction | Item | Category | SystemSetting | Banner | Role | ...
  entityId      String?
  action        String // CREATE | UPDATE | DELETE | PUBLISH | CANCEL | SETTLE
  payload       String  @db.NVarChar(Max) // JSON of the requested state
  previousData  String? @db.NVarChar(Max) // JSON of the state before the change
  changedFields String? @db.NVarChar(Max) // JSON array of field names that actually changed
  summary       String?

  status  String  @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  comment String? @db.NVarChar(Max)

  createdById String
  createdBy   User      @relation("ChangeCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById String?
  approvedBy   User?    @relation("ChangeApprovedBy", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([status])
  @@index([entityType, entityId])
  @@index([createdById])
  @@index([approvedById])
}

// --------------------------------------
// CMS & NOTIFICATIONS
// --------------------------------------

model Banner {
  id           String    @id @default(cuid())
  title        String
  titleAm      String?
  subtitle     String?
  imageUrl     String    @db.NVarChar(Max)
  linkUrl      String?
  displayOrder Int       @default(0)
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

model TermsAndConditions {
  id        String   @id @default(cuid())
  version   String
  title     String
  contentEn String   @db.NVarChar(Max)
  contentAm String?  @db.NVarChar(Max)
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auctions Auction[]
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  code      String   @unique // BID_CONFIRMED | AUCTION_ENDING | WINNER_ANNOUNCED | ...
  name      String
  channel   String   @default("SMS") // SMS | PUSH | INAPP
  subject   String?
  bodyEn    String   @db.NVarChar(Max)
  bodyAm    String?  @db.NVarChar(Max)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationLog {
  id           String    @id @default(cuid())
  templateCode String?
  channel      String    @default("SMS")
  recipient    String
  body         String    @db.NVarChar(Max)
  status       String    @default("QUEUED") // QUEUED | SENT | FAILED
  error        String?   @db.NVarChar(Max)
  bidderId     String?
  auctionId    String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([recipient])
  @@index([createdAt])
}

// --------------------------------------
// SETTINGS
// --------------------------------------

// Key/value global configuration. Everything the business may want to tune
// without a redeploy lives here — see src/lib/settings.ts for the defaults.
model SystemSetting {
  key         String   @id
  value       String   @db.NVarChar(Max) // JSON-encoded
  description String?
  category    String   @default("general")
  updatedById String?
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([updatedById])
}
