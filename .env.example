# ------------------------------------------------------------------
# GuessLow — environment configuration
# Copy to .env and fill in. Never commit the real .env.
# ------------------------------------------------------------------

# --- Database (SQL Server) ---
# Local dev example (trusted connection is not supported; use SQL auth):
DATABASE_URL="sqlserver://localhost:1433;database=guesslow;user=sa;password=YourStrong!Passw0rd;encrypt=true;trustServerCertificate=true"

# --- Session signing ---
# REQUIRED, minimum 32 characters. The app refuses to sign or verify a token
# when this is unset, still holds the placeholder below, or is too short: an
# empty signing key would let anybody forge a Super Admin session while the
# application looked perfectly healthy.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Session lifetime ---
# Idle timeout in minutes (clamped to 5-240) and absolute lifetime in hours
# (clamped to 1-72). A session is revoked once either limit passes. Renewing an
# expired access token never extends the absolute deadline, so a stolen token
# cannot keep a session alive indefinitely.
SESSION_IDLE_MINUTES="30"
SESSION_ABSOLUTE_HOURS="8"
# Mini-app bidder cookie: absolute cap in hours (clamped to 1-24) and idle
# timeout in minutes (clamped to 5-240). The cookie is re-issued on each
# request with a fresh idle window, never past the absolute cap.
BIDDER_SESSION_HOURS="8"
BIDDER_IDLE_MINUTES="30"

# --- Bid amount encryption (required) ---
# Bid amounts are stored only as AES-256-GCM ciphertext; this is the key that
# opens them. Without it the app cannot accept a bid or settle an auction.
#
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Treat it like a database credential: keep it out of the database, out of the
# repo, and out of anywhere your DB backups land — a backup plus this key is the
# plaintext bid distribution. Losing it means losing every recorded amount,
# settled auctions included, so keep an escrowed copy.
BID_ENCRYPTION_KEY=""

# Set only while rotating. The outgoing key stays here so rows sealed under it
# still open, while new bids are sealed under BID_ENCRYPTION_KEY. Remove it once
# `npm run bids:encrypt` has re-sealed everything under the new key.
BID_ENCRYPTION_KEY_PREVIOUS=""

# --- Super app (mini-app identity) ---
# GET endpoint that accepts `Authorization: Bearer <token>` and returns { phone }.
TOKEN_VALIDATION_API_URL="https://superapp.example.et/api/token/validate"

# --- Super app payment gateway (bid service fees) ---
PAYMENT_URL="https://superapp.example.et/api/payment/initiate"
PAYMENT_KEY="merchant-signing-key"
ACCOUNT_NO="1000123456789"
COMPANY_NAME="GuessLow"
# Must be publicly reachable by the gateway.
CALLBACK_URL="https://guesslow.example.et/api/payment/callback"
# Reject a callback whose signature does not match, rather than logging the
# mismatch and processing it anyway. Unset means strict in production and
# permissive locally; set it to "false" only while confirming the signature
# format against the gateway, and expect a warning in the production log.
PAYMENT_CALLBACK_STRICT=""

# --- Notifications (optional; messages are logged when unset) ---
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="GuessLow"

# --- Testing ---
# Adds a bypass sign-in to /connect so the mini-app can be used without a
# super-app token. Test sessions are labelled in the UI and their bids never
# charge a fee. MUST stay unset in production.
ALLOW_TEST_LOGIN="false"

# --- Uploads ---
# Where uploaded artwork is stored. Defaults to public/uploads. Point this at a
# persistent volume on servers where the app directory is replaced on deploy,
# otherwise previously uploaded images vanish with the old release.
UPLOAD_DIR=""

# --- Misc ---
# Origins allowed to make credentialed cross-origin calls, comma separated.
# Must be exact https origins — a wildcard fails the build, because pairing one
# with Access-Control-Allow-Credentials would expose authenticated sessions to
# every origin on the internet. The first entry is the CORS response header;
# all of them are accepted by the proxy's same-origin check.
ALLOWED_ORIGIN="https://guesslow.example.et"

# Set to "true" only when a reverse proxy you control overwrites
# X-Forwarded-For / X-Forwarded-Proto on the way in. Left unset, those headers
# are ignored entirely: they are client-supplied, so honouring them would let a
# caller pick their own rate-limit bucket and write any address they like into
# the audit trail. Ignoring them degrades per-address limits to one global
# ceiling, which is restrictive but sound.
TRUST_PROXY="false"

# Who may frame this application. Defaults to 'none' (with X-Frame-Options:
# DENY) — a clickjacked frame over the admin console can approve a payout with
# one misdirected click. Set to 'self' or an explicit origin only if an
# embedded surface is genuinely required.
FRAME_ANCESTORS=""

# Shared secret for the /api/cron/* maintenance endpoints. Minimum 16
# characters; the placeholder below is rejected at runtime.
CRON_SECRET="change-me"

# Wire logging for the super-app integration. Forced off in production
# regardless of this value — it prints request bodies and header maps, and the
# same switch decides whether gateway error text reaches the webview.
SUPERAPP_DEBUG=""
SUPERAPP_DEBUG_SECRETS=""

NODE_ENV="development"
